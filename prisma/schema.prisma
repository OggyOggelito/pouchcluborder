// Pouch Club restock ordering — Phase 1 schema.
//
// SQLite for now. Nothing here is SQLite-specific beyond the datasource block,
// so moving to Postgres/Supabase later means swapping the provider + url and
// re-running migrations; application code talks to src/lib/repositories/* only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

model Store {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  city   String?
  /// Groups stores a manager looks after together, e.g. "Stockholm".
  /// Free text rather than an enum so a region can be added without a migration.
  region String?
  /// TooEasy's `StoreNumber`. Needed as well as the employee mapping: a shift
  /// comes back keyed by TooEasy's store, and ShiftEntry carries ours.
  tooEasyStoreNumber String? @unique
  orders Order[]
  access StoreAccess[]
  shifts Shift[]
  checklistRuns ChecklistRun[]
  customerRequests  CustomerRequest[]
  transfersRequested StockTransfer[] @relation("requestingStore")
  transfersTargeted  StockTransfer[] @relation("targetStore")
  transfersAccepted  StockTransfer[] @relation("acceptingStore")
  shiftNotes   ShiftNote[]
  issueReports IssueReport[]

  @@index([region])
  @@map("stores")
}

/// Accounts are created by an admin — there is no self-signup.
model User {
  id             String @id @default(cuid())
  email          String @unique
  hashedPassword String
  name           String?
  /// OWNER | ADMIN. Kept as a string rather than an enum so more roles can be
  /// added without a migration; validated in src/lib/roles.ts.
  role String @default("OWNER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Shown to managers looking for shift cover — there is no in-app messaging,
  /// so they phone or email the person directly.
  phone String?

  /// TooEasy WFM's `EmployeeId` (their string identifier, not their numeric PK).
  /// Mapped by hand at /admin/tooeasy — emails and names do not match cleanly
  /// between the two systems, so this is never inferred.
  tooEasyEmployeeId String? @unique

  storeAccess   StoreAccess[]
  orders        Order[]
  shifts        Shift[]
  announcements Announcement[]
  checklistRuns ChecklistRun[]
  checkedItems  ChecklistRunItem[]
  quizAttempts  QuizAttempt[]
  customerRequests CustomerRequest[]
  transfersCreated StockTransfer[]
  transferEvents   StockTransferEvent[]
  notifications    Notification[]
  authoredNotes    ShiftNote[]   @relation("authoredNotes")
  resolvedNotes    ShiftNote[]   @relation("resolvedNotes")
  reportedIssues   IssueReport[] @relation("reportedIssues")
  assignedIssues   IssueReport[] @relation("assignedIssues")
  issueEvents      IssueEvent[]
  editedArticles   KnowledgeArticle[] @relation("editedArticles")

  @@map("users")
}

/// One scheduled shift for one person.
///
/// Written only by the manual import (`ManualImportScheduleProvider`); read
/// only through `ScheduleProvider`, never directly from a component.
model Shift {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Local calendar date, midnight UTC, so a day is one value to group by.
  date DateTime
  /// "07:30" / "16:00" — local wall-clock, kept as text so an import cannot
  /// shift a shift by an hour through a timezone conversion.
  startTime String
  endTime   String

  /// Which import produced it, e.g. "csv" or "ics".
  source     String
  /// Batch marker, so re-importing the same file replaces rather than duplicates.
  importBatch String?
  importedAt DateTime @default(now())

  /// One person cannot hold two shifts starting at the same time on a day.
  @@unique([userId, date, startTime])
  @@index([storeId, date])
  @@index([date])
  @@map("shifts")
}

/// Internal announcements. Drafts have no publishedAt.
model Announcement {
  id       String  @id @default(cuid())
  title    String
  /// Markdown, rendered with the same component as brand content.
  body     String
  /// NewProduct | NewStore | General — validated in src/lib/announcements.ts.
  category String  @default("General")
  pinned   Boolean @default(false)

  /// Null while it is a draft.
  publishedAt DateTime?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@index([pinned])
  @@map("announcements")
}

/// Which stores a user may order for. A join table rather than a column on
/// User, because an owner can hold more than one store.
model StoreAccess {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("store_access")
}

/// Editorial content about a brand, for the staff knowledge dashboard.
/// Separate from Product.brand, which stays the parsed string the importer
/// writes — brandId is the link between the two.
model Brand {
  id   String @id @default(cuid())
  /// Matches the parsed Product.brand exactly, e.g. "77", "Loop", "Vozol".
  name String @unique
  /// URL-safe form used by /staff/brands/[slug].
  slug String @unique

  /// Distributor code(s) seen on this brand's products (LUNA, SMD, ECIGG...).
  /// Internal reference only — a distributor is not a retail brand.
  manufacturerCode String?
  countryOfOrigin  String?

  /// One paragraph: what the brand is and how it is positioned.
  shortDescription String?
  /// Markdown. How the pouches or vapes are actually made.
  manufacturingProcess String?
  /// Markdown. How nicotine, tobacco and flavouring are blended or dosed.
  blendingNotes String?

  logoUrl      String?
  heroImageUrl String?
  websiteUrl   String?

  /// Drafts stay invisible to staff until this is switched on.
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  quizzes  Quiz[]

  @@index([published])
  @@map("brands")
}

model Product {
  id     String @id @default(cuid())
  brand  String
  flavor String
  /// Nicotine strength as displayed, e.g. "10mg".
  strength String
  /// Mini | Slim | Normal | Large
  format   String
  /// What one stock costs the store in SEK (a stock = `unitsPerStock` cans).
  pricePerStock Float
  active        Boolean @default(true)

  // ---------------------------------------------------------------
  // Supplier masterdoc fields. All optional: the CSV path never sets
  // them, and only the .xlsx import fills them in.
  // ---------------------------------------------------------------

  /// Art.nr. — the supplier's article number, the real business key.
  sku String?
  /// Nicotine pouch | Nicotine-free pouch | Tobacco snus | Vape
  category String?
  /// Fabr./Repr. — distributor code (LUNA, SMD, ECIGG...), NOT a retail brand.
  manufacturerCode String?
  /// Leverantör
  supplier String?
  /// Innehåll DFP — cans per stock.
  unitsPerStock Int?
  /// Pris 1st inkl. moms — shelf price for one can, not what the store pays.
  unitPrice Float?
  /// Pris 2st inkl. moms
  casePrice Float?
  /// Inpris — what the store pays per can. This is what pricePerStock is built from.
  costPrice Float?
  eanKfp    String?
  eanDfp    String?
  stockMin  Int?
  stockMax  Int?
  /// Raw Benämning, kept so a bad parse can always be traced back.
  sourceName String?

  /// Supplier flavour description, shown under the flavour on the brand page.
  /// Filled from content/source/* by `npm run brands:import`; no import path
  /// from the masterdoc writes it.
  description String?

  /// Comma-separated flavour groups from src/lib/flavor-tags.ts, e.g.
  /// "berry,mint". Derived, except where an admin has set them by hand.
  flavorTags String?
  /// True once an admin edits the tags. The re-tagging job skips these rows,
  /// so a catalog re-import can never undo hand-sorted products.
  tagsEditedByAdmin Boolean @default(false)
  /// Set when the name parser was not confident; see reviewNotes.
  needsReview Boolean @default(false)
  reviewNotes String?

  // ---------------------------------------------------------------
  // Facts matched in from snusbolaget.se by EAN (npm run enrich:strengths).
  //
  // Deliberately NOT written into `strength`: that field is part of
  // @@unique([brand, flavor, strength, format]), which is how the importer
  // finds an existing product. Changing it would make the next import miss
  // the row, create a duplicate, and leave this one deactivated. These are
  // additive, and no import path writes them.
  // ---------------------------------------------------------------

  /// Manufacturer's nicotine content per portion, e.g. 9 for "9 mg/portion".
  nicotineMgPerPortion Float?
  /// Manufacturer's nicotine content per gram.
  nicotineMgPerGram Float?
  portionsPerCan    Int?
  /// Who actually makes it, e.g. "Swedish Match". Distinct from
  /// `manufacturerCode`, which is the masterdoc's distributor code.
  manufacturer String?
  /// Where the figures came from, e.g. "snusbolaget.se".
  nicotineSource String?
  nicotineCheckedAt DateTime?

  /// Link to the editorial Brand record. Backfilled from `brand` by
  /// `npm run backfill:brands`; the importer keeps it in sync on every import.
  brandId  String?
  brandRef Brand?  @relation(fields: [brandId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderLines OrderLine[]
  customerRequests CustomerRequest[]
  transferLines    StockTransferLine[]
  issueReports     IssueReport[]

  // A variant is uniquely identified by these four fields. CSV import upserts on it.
  @@unique([brand, flavor, strength, format])
  @@index([brand, flavor])
  @@index([active])
  @@index([sku])
  @@index([needsReview])
  @@index([brandId])
  @@map("products")
}

model Order {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  submittedAt DateTime @default(now())
  /// Free-text note from the store, optional.
  note String?

  /// Who submitted it. Nullable: orders placed before logins existed have no
  /// user, and those rows must stay valid.
  placedByUserId String?
  placedBy       User?   @relation(fields: [placedByUserId], references: [id])

  lines OrderLine[]

  @@index([storeId, submittedAt])
  @@index([placedByUserId])
  @@map("orders")
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  /// Price snapshot at submit time, so re-downloading an old order keeps its
  /// original totals even after the catalog is re-imported.
  unitPrice Float

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_lines")
}

// ---------------------------------------------------------------------------
// Checklists
// ---------------------------------------------------------------------------

/// ONBOARDING | STORE_OPENING | DAILY_OPEN | DAILY_CLOSE — validated in
/// src/lib/checklists.ts. A string rather than an enum so a fifth type needs
/// no migration.
model ChecklistTemplate {
  id       String  @id @default(cuid())
  type     String
  title    String
  /// Shown above the items; markdown.
  intro    String?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ChecklistItem[]
  runs  ChecklistRun[]

  @@index([type, active])
  @@map("checklist_templates")
}

model ChecklistItem {
  id         String  @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title       String
  /// Markdown.
  description String?
  /// Internal link, e.g. "/staff/brands/zyn". Relative paths only.
  linkUrl  String?
  required Boolean @default(true)
  position Int     @default(0)

  @@index([templateId, position])
  @@map("checklist_items")
}

/// One instance of a template being worked through.
///
/// A run copies its items at creation (ChecklistRunItem), so editing a
/// template never rewrites history for a run already in progress.
model ChecklistRun {
  id         String @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])

  /// ONBOARDING runs belong to a person.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Store-scoped runs (STORE_OPENING, DAILY_*).
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// "2026-10-30" for the daily types; null otherwise. Part of the uniqueness
  /// that keeps one run per store per day.
  runDate String?

  /// Copied from the template so a renamed template does not retitle history.
  title String

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  items ChecklistRunItem[]

  @@unique([templateId, storeId, runDate])
  @@unique([templateId, userId])
  @@index([storeId, runDate])
  @@map("checklist_runs")
}

model ChecklistRunItem {
  id    String @id @default(cuid())
  runId String
  run   ChecklistRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Snapshot of the template item at the moment the run was created.
  title       String
  description String?
  linkUrl     String?
  required    Boolean @default(true)
  position    Int     @default(0)

  checkedAt     DateTime?
  checkedById   String?
  checkedBy     User?     @relation(fields: [checkedById], references: [id])
  /// Free text from whoever worked the list.
  note String?

  @@index([runId, position])
  @@map("checklist_run_items")
}

// ---------------------------------------------------------------------------
// Quizzes
// ---------------------------------------------------------------------------

model Quiz {
  id          String  @id @default(cuid())
  title       String
  description String?
  /// Optional link to a brand the quiz is about.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([published])
  @@map("quizzes")
}

model QuizQuestion {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  text String
  /// JSON array of option strings.
  options String
  /// Index into `options`.
  correctOption Int
  /// Markdown, shown after answering.
  explanation String?
  position    Int    @default(0)

  @@index([quizId, position])
  @@map("quiz_questions")
}

model QuizAttempt {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score Int
  total Int
  /// JSON: questionId -> chosen option index.
  answers     String
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  @@index([quizId, userId])
  @@index([userId])
  @@map("quiz_attempts")
}

// ---------------------------------------------------------------------------
// Customer requests
// ---------------------------------------------------------------------------

/// "A customer asked for X and we did not have it."
///
/// Demand signal only — this never touches stock, order quantities or
/// suggestions. Deliberately holds NO customer personal data: there is no
/// name, phone, email or callback field, and the UI says so under every box.
model CustomerRequest {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Audit only — who logged it. Never shown in the ranking.
  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id])

  /// NOT_STOCKED | OUT_OF_STOCK | OTHER — validated in src/lib/customer-requests.ts.
  kind String

  /// Free text, capped at 120 characters each.
  brandText  String?
  flavorText String?

  /// Set when the request is about a product we do carry (OUT_OF_STOCK).
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  /// Lowercased, diacritics stripped, whitespace collapsed. The dedup key.
  normalizedKey String

  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// NEW | CONSIDERING | ADDED | WONT_ADD, set by an admin.
  status     String  @default("NEW")
  statusNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per store, kind and normalised request — logging the same thing
  /// again increments `count` instead of creating a duplicate.
  @@unique([storeId, kind, normalizedKey])
  @@index([status])
  @@index([lastSeenAt])
  @@map("customer_requests")
}

// ---------------------------------------------------------------------------
// Store-to-store transfers
// ---------------------------------------------------------------------------

/// "Can you spare two stockar of X?"
///
/// Coordination only. A request reserves nothing — the sending store decides
/// whether it can spare anything, and no stock count exists to change.
model StockTransfer {
  id String @id @default(cuid())

  requestingStoreId String
  requestingStore   Store  @relation("requestingStore", fields: [requestingStoreId], references: [id])

  /// Null means an open request to every store in the region.
  targetStoreId String?
  targetStore   Store?  @relation("targetStore", fields: [targetStoreId], references: [id])

  /// Set the moment one store accepts; this is what closes the race.
  acceptingStoreId String?
  acceptingStore   Store?  @relation("acceptingStore", fields: [acceptingStoreId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  /// REQUESTED | ACCEPTED | SENT | RECEIVED | DECLINED | CANCELLED
  status String @default("REQUESTED")
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines  StockTransferLine[]
  events StockTransferEvent[]

  @@index([requestingStoreId, status])
  @@index([targetStoreId, status])
  @@index([acceptingStoreId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id         String @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  /// STOCK | CAN. Stored explicitly and never assumed — a store asking for
  /// "two" means very different things depending on which.
  unit String @default("STOCK")

  @@index([transferId])
  @@map("stock_transfer_lines")
}

/// Append-only timeline.
model StockTransferEvent {
  id         String @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  /// The status the transfer moved to, or CREATED.
  type   String
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  /// Short human-readable addition, e.g. the accepting store's name.
  detail String?

  createdAt DateTime @default(now())

  @@index([transferId, createdAt])
  @@map("stock_transfer_events")
}

// ---------------------------------------------------------------------------
// In-app notifications
// ---------------------------------------------------------------------------

/// There was no notification service before this, so this is the minimal
/// in-app one: a row per recipient, marked read when opened. No email or push
/// — nothing in the app can send either yet.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Short machine type, e.g. "TRANSFER_REQUESTED".
  type    String
  title   String
  body    String?
  /// Internal link, relative only.
  linkUrl String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Store communication: shift notes, problem reports, routines
//
// What the stores still did in chat groups and on paper. All three are
// deliberately small, and none of them invites personal data: the UI repeats
// that under every text box, and there is no name, phone or customer field.
// ---------------------------------------------------------------------------

/// "What the next shift needs to know."
///
/// A feed per store. Notes are hidden into an archive rather than deleted, so
/// a handover can be looked up afterwards.
model ShiftNote {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("authoredNotes", fields: [authorId], references: [id])

  /// Free text, capped at MAX_NOTE_LENGTH in src/lib/shift-notes.ts.
  text String
  /// INFO | IMPORTANT | TODO — validated in src/lib/shift-notes.ts.
  category String @default("INFO")
  /// Keeps a note out of the archive regardless of age.
  pinned Boolean @default(false)

  /// TODO only: who ticked it off, and when.
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("resolvedNotes", fields: [resolvedById], references: [id])

  /// Set by an OWNER or ADMIN, or by age. Archived notes still exist.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, createdAt])
  @@index([storeId, archivedAt])
  @@index([storeId, category, resolvedAt])
  @@map("shift_notes")
}

/// Damaged goods, a wrong price label, broken equipment, a delivery problem.
model IssueReport {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  reporterId String?
  reporter   User?   @relation("reportedIssues", fields: [reporterId], references: [id])

  /// DAMAGED_GOODS | PRICE_OR_LABEL | EQUIPMENT | DELIVERY | OTHER.
  category String

  /// Set when the report is about a specific catalog product.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  text String

  /// NEW | IN_PROGRESS | RESOLVED — validated in src/lib/issues.ts.
  status String @default("NEW")

  /// An ADMIN who took it on. Enforced in the action, not the schema, because
  /// role is a string column rather than a relation.
  assigneeId String?
  assignee   User?   @relation("assignedIssues", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events IssueEvent[]

  @@index([storeId, status])
  @@index([status, createdAt])
  @@index([assigneeId])
  @@map("issue_reports")
}

/// Append-only timeline: status changes, assignments and comments.
model IssueEvent {
  id      String      @id @default(cuid())
  issueId String
  issue   IssueReport @relation(fields: [issueId], references: [id], onDelete: Cascade)

  /// CREATED | STATUS | ASSIGNED | COMMENT.
  type   String
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  /// The new status, the assignee's name, or the comment text.
  detail String?

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
  @@map("issue_events")
}

/// "How do we do X" — separate from the brand pages, which are about products.
model KnowledgeArticle {
  id    String @id @default(cuid())
  title String
  slug  String @unique
  /// Markdown, rendered with the same component as brand and news content.
  body  String

  /// Free text matching a KnowledgeCategory name, so renaming a category does
  /// not need a migration. Null means uncategorised.
  category String?

  published Boolean @default(false)

  updatedById String?
  updatedBy   User?   @relation("editedArticles", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([category])
  @@map("knowledge_articles")
}

/// The chip list on /staff/routines. Managed by an ADMIN.
model KnowledgeCategory {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  @@map("knowledge_categories")
}
