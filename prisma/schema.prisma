// Pouch Club restock ordering — Phase 1 schema.
//
// SQLite for now. Nothing here is SQLite-specific beyond the datasource block,
// so moving to Postgres/Supabase later means swapping the provider + url and
// re-running migrations; application code talks to src/lib/repositories/* only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

model Store {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  city   String?
  orders Order[]

  @@map("stores")
}

model Product {
  id     String @id @default(cuid())
  brand  String
  flavor String
  /// Nicotine strength as displayed, e.g. "10mg".
  strength String
  /// Mini | Slim | Normal | Large
  format   String
  /// Price per stock in SEK (a stock = `unitsPerStock` cans).
  pricePerStock Float
  active        Boolean @default(true)

  // ---------------------------------------------------------------
  // Supplier masterdoc fields. All optional: the CSV path never sets
  // them, and only the .xlsx import fills them in.
  // ---------------------------------------------------------------

  /// Art.nr. — the supplier's article number, the real business key.
  sku String?
  /// Nicotine pouch | Nicotine-free pouch | Tobacco snus | Vape
  category String?
  /// Fabr./Repr. — distributor code (LUNA, SMD, ECIGG...), NOT a retail brand.
  manufacturerCode String?
  /// Leverantör
  supplier String?
  /// Innehåll DFP — cans per stock.
  unitsPerStock Int?
  /// Pris 1st inkl. moms
  unitPrice Float?
  /// Pris 2st inkl. moms
  casePrice Float?
  /// Inpris — cost price.
  costPrice Float?
  eanKfp    String?
  eanDfp    String?
  stockMin  Int?
  stockMax  Int?
  /// Raw Benämning, kept so a bad parse can always be traced back.
  sourceName String?
  /// Set when the name parser was not confident; see reviewNotes.
  needsReview Boolean @default(false)
  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderLines OrderLine[]

  // A variant is uniquely identified by these four fields. CSV import upserts on it.
  @@unique([brand, flavor, strength, format])
  @@index([brand, flavor])
  @@index([active])
  @@index([sku])
  @@index([needsReview])
  @@map("products")
}

model Order {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  submittedAt DateTime @default(now())
  /// Free-text note from the store, optional.
  note String?

  lines OrderLine[]

  @@index([storeId, submittedAt])
  @@map("orders")
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  /// Price snapshot at submit time, so re-downloading an old order keeps its
  /// original totals even after the catalog is re-imported.
  unitPrice Float

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_lines")
}
