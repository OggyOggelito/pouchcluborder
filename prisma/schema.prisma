// Pouch Club restock ordering — Phase 1 schema.
//
// SQLite for now. Nothing here is SQLite-specific beyond the datasource block,
// so moving to Postgres/Supabase later means swapping the provider + url and
// re-running migrations; application code talks to src/lib/repositories/* only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

model Store {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  city   String?
  orders Order[]
  access StoreAccess[]

  @@map("stores")
}

/// Accounts are created by an admin — there is no self-signup.
model User {
  id             String @id @default(cuid())
  email          String @unique
  hashedPassword String
  name           String?
  /// OWNER | ADMIN. Kept as a string rather than an enum so more roles can be
  /// added without a migration; validated in src/lib/roles.ts.
  role String @default("OWNER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeAccess StoreAccess[]
  orders      Order[]

  @@map("users")
}

/// Which stores a user may order for. A join table rather than a column on
/// User, because an owner can hold more than one store.
model StoreAccess {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("store_access")
}

/// Editorial content about a brand, for the staff knowledge dashboard.
/// Separate from Product.brand, which stays the parsed string the importer
/// writes — brandId is the link between the two.
model Brand {
  id   String @id @default(cuid())
  /// Matches the parsed Product.brand exactly, e.g. "77", "Loop", "Vozol".
  name String @unique
  /// URL-safe form used by /staff/brands/[slug].
  slug String @unique

  /// Distributor code(s) seen on this brand's products (LUNA, SMD, ECIGG...).
  /// Internal reference only — a distributor is not a retail brand.
  manufacturerCode String?
  countryOfOrigin  String?

  /// One paragraph: what the brand is and how it is positioned.
  shortDescription String?
  /// Markdown. How the pouches or vapes are actually made.
  manufacturingProcess String?
  /// Markdown. How nicotine, tobacco and flavouring are blended or dosed.
  blendingNotes String?

  logoUrl      String?
  heroImageUrl String?
  websiteUrl   String?

  /// Drafts stay invisible to staff until this is switched on.
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([published])
  @@map("brands")
}

model Product {
  id     String @id @default(cuid())
  brand  String
  flavor String
  /// Nicotine strength as displayed, e.g. "10mg".
  strength String
  /// Mini | Slim | Normal | Large
  format   String
  /// What one stock costs the store in SEK (a stock = `unitsPerStock` cans).
  pricePerStock Float
  active        Boolean @default(true)

  // ---------------------------------------------------------------
  // Supplier masterdoc fields. All optional: the CSV path never sets
  // them, and only the .xlsx import fills them in.
  // ---------------------------------------------------------------

  /// Art.nr. — the supplier's article number, the real business key.
  sku String?
  /// Nicotine pouch | Nicotine-free pouch | Tobacco snus | Vape
  category String?
  /// Fabr./Repr. — distributor code (LUNA, SMD, ECIGG...), NOT a retail brand.
  manufacturerCode String?
  /// Leverantör
  supplier String?
  /// Innehåll DFP — cans per stock.
  unitsPerStock Int?
  /// Pris 1st inkl. moms — shelf price for one can, not what the store pays.
  unitPrice Float?
  /// Pris 2st inkl. moms
  casePrice Float?
  /// Inpris — what the store pays per can. This is what pricePerStock is built from.
  costPrice Float?
  eanKfp    String?
  eanDfp    String?
  stockMin  Int?
  stockMax  Int?
  /// Raw Benämning, kept so a bad parse can always be traced back.
  sourceName String?
  /// Set when the name parser was not confident; see reviewNotes.
  needsReview Boolean @default(false)
  reviewNotes String?

  // ---------------------------------------------------------------
  // Facts matched in from snusbolaget.se by EAN (npm run enrich:strengths).
  //
  // Deliberately NOT written into `strength`: that field is part of
  // @@unique([brand, flavor, strength, format]), which is how the importer
  // finds an existing product. Changing it would make the next import miss
  // the row, create a duplicate, and leave this one deactivated. These are
  // additive, and no import path writes them.
  // ---------------------------------------------------------------

  /// Manufacturer's nicotine content per portion, e.g. 9 for "9 mg/portion".
  nicotineMgPerPortion Float?
  /// Manufacturer's nicotine content per gram.
  nicotineMgPerGram Float?
  portionsPerCan    Int?
  /// Who actually makes it, e.g. "Swedish Match". Distinct from
  /// `manufacturerCode`, which is the masterdoc's distributor code.
  manufacturer String?
  /// Where the figures came from, e.g. "snusbolaget.se".
  nicotineSource String?
  nicotineCheckedAt DateTime?

  /// Link to the editorial Brand record. Backfilled from `brand` by
  /// `npm run backfill:brands`; the importer keeps it in sync on every import.
  brandId  String?
  brandRef Brand?  @relation(fields: [brandId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderLines OrderLine[]

  // A variant is uniquely identified by these four fields. CSV import upserts on it.
  @@unique([brand, flavor, strength, format])
  @@index([brand, flavor])
  @@index([active])
  @@index([sku])
  @@index([needsReview])
  @@index([brandId])
  @@map("products")
}

model Order {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  submittedAt DateTime @default(now())
  /// Free-text note from the store, optional.
  note String?

  /// Who submitted it. Nullable: orders placed before logins existed have no
  /// user, and those rows must stay valid.
  placedByUserId String?
  placedBy       User?   @relation(fields: [placedByUserId], references: [id])

  lines OrderLine[]

  @@index([storeId, submittedAt])
  @@index([placedByUserId])
  @@map("orders")
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  /// Price snapshot at submit time, so re-downloading an old order keeps its
  /// original totals even after the catalog is re-imported.
  unitPrice Float

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_lines")
}
