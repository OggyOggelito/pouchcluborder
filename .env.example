# SQLite file lives inside prisma/ and is git-ignored.
DATABASE_URL="file:./prisma/dev.db"

# Auth.js session signing key — REQUIRED.
# Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Optional: passwords used by `npm run seed:users` for the generated accounts.
# SEED_ADMIN_EMAIL="admin@pouchclub.se"
# SEED_ADMIN_PASSWORD="..."
# SEED_OWNER_PASSWORD="..."

# Which schedule backend is live: "manual" (CSV/ICS upload) or "tooeasy" (the
# REST API). Stays on "manual" until the demo-vs-production question below is
# settled — see the README.
SCHEDULE_PROVIDER="manual"

# TooEasy WFM REST API. Only read when SCHEDULE_PROVIDER="tooeasy".
#
# WARNING: the base URL below is the DEMO environment the Swagger docs were
# published on. Confirm with TooEasy whether this mirrors production before
# pointing anything real at it.
TOOEASY_BASE_URL="https://apps4.2ezy.se/tooeasyDemoNew/tooeasy.External.WebAPI"
TOOEASY_USERNAME=""
TOOEASY_PASSWORD=""
