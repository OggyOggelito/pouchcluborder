# SQLite file lives inside prisma/ and is git-ignored.
DATABASE_URL="file:./prisma/dev.db"

# Auth.js session signing key — REQUIRED.
# Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Optional: passwords used by `npm run seed:users` for the generated accounts.
# SEED_ADMIN_EMAIL="admin@pouchclub.se"
# SEED_ADMIN_PASSWORD="..."
# SEED_OWNER_PASSWORD="..."

# Which schedule backend is live:
#   "manual"  — the schedule each store types into the portal (the default)
#   "import"  — the older CSV/ICS upload at /admin/schedule
#   "tooeasy" — the REST API, implemented but dormant (no API access granted)
SCHEDULE_PROVIDER="manual"

# How far outside opening hours a shift may run before the grid warns about it.
# Somebody has to unlock, count the till and cash up, so clock-hours are never
# shift hours. Default 30, clamped to 0–120.
# SCHEDULE_SHIFT_BUFFER_MINUTES="30"

# TooEasy WFM REST API. Only read when SCHEDULE_PROVIDER="tooeasy".
#
# WARNING: the base URL below is the DEMO environment the Swagger docs were
# published on. Confirm with TooEasy whether this mirrors production before
# pointing anything real at it.
TOOEASY_BASE_URL="https://apps4.2ezy.se/tooeasyDemoNew/tooeasy.External.WebAPI"
TOOEASY_USERNAME=""
TOOEASY_PASSWORD=""

# Sales statistics (Part A). Off by default: with this unset there are no
# statistics routes and no menu items anywhere. Set to "1" to switch on.
SALES_STATS_ENABLED=""

# Where sales figures come from: "manual" (CSV upload, default) or "sharp"
# (the till system — not configured, see docs/sharp-api-intake.md).
SALES_PROVIDER="manual"

# Sharp — the till system. Nothing reads these yet: `SharpSalesProvider` is a
# stub that throws, because we have no specification. They exist so
# `npm run sharp:probe` has somewhere to point the moment we are given access.
# Put real values in .env.local, never here.
#
# SHARP_BASE_URL=""
# SHARP_API_KEY=""              # sent as "Authorization: Bearer <key>"
# SHARP_AUTH_HEADER=""          # ...or any other header name
# SHARP_AUTH_VALUE=""

# Fortnox. Nothing reads these either — there is no Fortnox code in this repo.
# See docs/fortnox-intake.md for what has to be decided first, and note that
# OAuth2 means a refresh token with a limited life, which needs durable storage
# and a schedule before any of this is useful.
#
# FORTNOX_CLIENT_ID=""
# FORTNOX_CLIENT_SECRET=""
# FORTNOX_REDIRECT_URI=""
